rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Current round number. Everyone signed in reads it; only admins change it.
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Admin list. Add documents here by hand in the Firebase console.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Each player's saved card. Everyone signed in sees the standings; you only write your own.
    match /players/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Winners board. You post your own win; admins clear the board for a new round.
    match /winners/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }
  }
}
